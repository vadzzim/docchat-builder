{
  "name": "docchat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "node demo/server.mjs",
    "typecheck:app": "tsc --noEmit",
    "typecheck:edge": "npx --yes deno@2.9.6 check --no-lock --node-modules-dir=none \"supabase/functions/*/index.ts\"",
    "typecheck": "npm run typecheck:app && npm run typecheck:edge",
    "lint:app": "npx --yes deno@2.9.6 lint --rules-exclude=no-import-prefix,no-sloppy-imports,no-window,no-window-prefix,no-var,no-inner-declarations app components lib public",
    "lint:edge": "npx --yes deno@2.9.6 lint --rules-exclude=no-import-prefix supabase/functions",
    "lint": "npm run lint:app && npm run lint:edge",
    "test:regression": "npx --yes deno@2.9.6 test --no-lock --allow-env supabase/tests/critical-regressions.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test:regression",
    "setup:local": "node scripts/local-setup.mjs",
    "test:ingestion": "node scripts/ingestion-integration.mjs",
    "test:chat": "node scripts/chat-integration.mjs",
    "test:billing": "node scripts/billing-integration.mjs",
    "test:cleanup": "node scripts/cleanup-integration.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:model": "node scripts/model-comparison.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2"
  }
}
