# Browser-safe Supabase values. Never put a service role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Supabase Edge Function secrets (configure with `supabase secrets set`).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=bge-m3
CRON_SECRET=replace-with-a-random-value
